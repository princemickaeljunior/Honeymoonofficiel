{
  "version": 2,
  "name": "honeymoon-agency",
  "routes": [
    { "src": "/api/claude", "dest": "/api/claude.js" },
    { "src": "/dashboard", "dest": "/dashboard.html" },
    { "src": "/studio", "dest": "/studio.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/dashboard",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/studio",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
